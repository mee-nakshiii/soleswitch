# Spotify Developer Application Configuration (PKCE Flow)
# Create an application in https://developer.spotify.com/dashboard

# 1. Spotify App Client ID (Required)
# Found in your Spotify Developer App Dashboard under "Settings"
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# 2. OAuth Redirect URI (Optional, defaults to window.location.origin + pathname)
# Make sure this EXACT URI is added to your Redirect URIs in the Spotify Developer Dashboard!
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173
